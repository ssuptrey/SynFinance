# Patterns to ignore when building packages
# This supports shell glob matching, relative path matching, and negation (prefixed with !)

# Common VCS directories
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/

# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~

# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Testing and build outputs
.DS_Store
test/
tests/
testing/
.gitkeep
